{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MashVoice",
  "version": "1.0.4",
  "identifier": "com.mymasha.mashvoice",
  "build": {
    "beforeDevCommand": "npm run ui:dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run ui:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MashVoice — Singularity 4.1 P2P",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "decorations": false,
        "backgroundColor": "#030305"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/MyMasha/MashVoice/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY2QTlGMEZCRjkxRDdBREUKUldUZWVoMzUrL0NwOWhsN3BvdElrZXdNMk1pVEt2ZWxIaWJ2SEJRYkRUbzRxTVVZeEVkRW5uSjAK"
    }
  }
}
