# ============================================================================
# MashVoice Singularity 4.1 — Configuration Serveur / Admin (.env.example)
# ============================================================================
# IMPORTANT :
# - Copiez ce fichier vers `.env` UNIQUEMENT sur votre machine administrateur
#   si vous hébergez un noeud `mashvoice-server` dédié.
# - L'application Desktop Windows (.exe) fonctionne directement sans `.env`.
# - `.env` et tous les fichiers `data/*.secret` / `data/*.bin` / `data/*.json`
#   sont strictement ignorés par Git et protégés en lecture seule propriétaire
#   (`chmod 0600`), inaccessibles aux utilisateurs non-admin (`MEMBER`).
# ============================================================================

# Secret maître HMAC-SHA256 (optionnel : généré automatiquement en CSPRNG 256 bits
# dans `data/master.secret` avec permissions `0600` s'il n'est pas défini ici).
MASHVOICE_MASTER_SECRET=

# Masquer automatiquement les starterTokens d'amorçage dans `/api/bootstrap/public`
# même en loopback local (`true` recommandé sur un serveur partagé).
MASHVOICE_HIDE_STARTER_TOKENS=false

# Interface d'écoute du moteur Rust local dans Tauri (`false` = `127.0.0.1` uniquement,
# zéro exposition réseau local / Wi-Fi public).
MASHVOICE_BIND_PUBLIC=false

# Port HTTP/WS local du moteur Rust (défaut : 3080)
PORT=3080

# Optionnel (Admin uniquement) : jeton GitHub si votre serveur effectue >60 checks/heure
# sur l'API publique GitHub Releases. Aucun jeton n'est requis en usage normal.
MASHVOICE_GITHUB_API_TOKEN=
